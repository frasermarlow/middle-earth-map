{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/.*/**",
      "*.py",
      "*.csv",
      "*.md",
      "*.jpeg",
      "*.png",
      "*.pth",
      "*.psd",
      "_*"
    ],
    "redirects": [
      { "source": "/index.html", "destination": "/", "type": 301 },
      { "source": "/places.html", "destination": "/places", "type": 301 },
      { "source": "/hobbit-map.html", "destination": "/hobbit-map", "type": 301 },
      { "source": "/silmarillion-map.html", "destination": "/silmarillion-map", "type": 301 }
    ],
    "rewrites": [
      { "source": "/about", "destination": "/about.html" },
      { "source": "/places", "destination": "/places.html" },
      { "source": "/hobbit-map", "destination": "/hobbit-map.html" },
      { "source": "/silmarillion-map", "destination": "/silmarillion-map.html" }
    ],
    "headers": [
      {
        "source": "**/*.js",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "tiles/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "tiles-sat/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      }
    ]
  }
}
